# Copy to .env for local overrides. Never commit real secrets.

# SQLite for local dev; Postgres in compose/production (postgres:// URLs are accepted).
INVOICEIQ_DATABASE_URL=sqlite:///./invoiceiq.db
# DATABASE_URL=postgresql://invoiceiq:invoiceiq@localhost:5432/invoiceiq

# Required whenever the database is not SQLite. Generate with: openssl rand -hex 32
INVOICEIQ_SECRET_KEY=change-me-in-production
INVOICEIQ_ACCESS_TOKEN_MINUTES=480
INVOICEIQ_MAX_UPLOAD_MB=10

# Extraction
INVOICEIQ_REVIEW_THRESHOLD=0.8
INVOICEIQ_AUTO_APPROVE_CLEAN=true
INVOICEIQ_TOTALS_TOLERANCE_COP=1.0
# LLM fallback: fake (offline, default) | anthropic | openai. Real providers need a key.
INVOICEIQ_LLM_PROVIDER=fake
INVOICEIQ_LLM_API_KEY=
INVOICEIQ_LLM_MODEL=
INVOICEIQ_LLM_CONFIDENCE_CAP=0.7
